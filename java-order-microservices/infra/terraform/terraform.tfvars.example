project_name        = "java-order-ms"
aws_region          = "eu-west-2"
vpc_cidr            = "10.42.0.0/16"
public_subnet_cidrs = ["10.42.1.0/24", "10.42.2.0/24"]

order_jwt_secret = "replace-with-long-random-secret-at-least-32-chars"

cors_allowed_origins = "https://johnoconnor-cv.vercel.app,https://cv-johnoconnor.netlify.app,http://localhost:5173"

# Sleep / wake schedule (set scheduler_enabled = false to disable).
scheduler_enabled = true
sleep_cron        = "cron(0 22 * * ? *)"
wake_cron         = "cron(0 8 ? * MON-FRI *)"
schedule_timezone = "Europe/London"
