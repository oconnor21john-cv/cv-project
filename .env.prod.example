# Copy this file to .env and fill in real values before running docker compose.
# Never commit the .env file to git.

# Your DuckDNS (or other) domain, e.g. myapp.duckdns.org
PUBLIC_DOMAIN=myapp.duckdns.org

# Strong random passwords for each Postgres database
# Generate with: openssl rand -hex 20
ORDERS_DB_PASSWORD=change_me
INVENTORY_DB_PASSWORD=change_me
PAYMENTS_DB_PASSWORD=change_me

# JWT signing secret — at least 32 bytes
# Generate with: openssl rand -hex 32
JWT_SECRET=change_me_use_at_least_32_bytes_long_random_value

# Comma-separated list of allowed CORS origins (your Netlify URL)
CORS_ALLOWED_ORIGINS=https://your-site.netlify.app

# Kafka cluster ID — generate once with: python3 -c "import uuid,base64; print(base64.urlsafe_b64encode(uuid.uuid4().bytes+uuid.uuid4().bytes[:4]).decode().rstrip('='))"
KAFKA_CLUSTER_ID=l32N8tTuQl-DlDy3x7299Q
